# Port configuration
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Node.js 17+ on Windows may encounter DNS SRV lookup bugs (ECONNREFUSED).
# If this occurs, the backend database config parses connection details
# and falls back to a direct replica set host list connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/nexus

# Secret key for JWT auth token signatures
JWT_SECRET=your_jwt_signing_secret_here

# Allowed CORS client origin (frontend dev server URL)
CORS_ORIGIN=http://localhost:5173
